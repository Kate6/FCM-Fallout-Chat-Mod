# Application settings and secrets copied from the authoritative environment.
# Keep Dev and Prod files separate. Never print or commit populated values.
NODE_ENV=production
ALLOWED_ORIGINS=https://dev.falloutchatmod.com
CLIENT_ORIGINS=https://dev.falloutchatmod.com

# Add the complete environment-specific backend configuration captured during
# preflight, including Discord, OAuth, session, MinIO bucket, and bridge values.
# Release announcements require both opt-in notification roles and never use
# @everyone/@here:
OVERLAY_UPDATE_NOTIFICATION_ROLE_ID=replace-with-environment-overlay-role-id
HUD_MOD_UPDATE_NOTIFICATION_ROLE_ID=replace-with-environment-hud-role-id
