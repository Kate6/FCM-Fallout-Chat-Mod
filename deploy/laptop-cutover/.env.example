# Copy once per environment. Never commit populated copies.
COMPOSE_PROJECT_NAME=fcm-cutover-dev
ORIGIN_PORT=17676
TUNNEL_ORIGIN_ALIAS=backend-dev

# Pin every image to an immutable sha256 digest recorded during preflight.
FCM_BACKEND_IMAGE=REQUIRED_IMAGE_AT_DIGEST
TIMESCALE_IMAGE=timescale/timescaledb:latest-pg15@REQUIRED_DIGEST
REDIS_IMAGE=redis:7-alpine@REQUIRED_DIGEST
MINIO_IMAGE=minio/minio:latest@REQUIRED_DIGEST
CLOUDFLARED_IMAGE=cloudflare/cloudflared:latest@REQUIRED_DIGEST

DB_USER=REQUIRED
DB_PASSWORD=REQUIRED
DB_NAME=REQUIRED
REDIS_PASSWORD=REQUIRED
MINIO_ROOT_USER=REQUIRED
MINIO_ROOT_PASSWORD=REQUIRED
